# Copy to .importer.env (git-ignored).
FIREFLY_III_URL=http://app:8080
# Where the importer sends you back after an import: the address you actually use, not the container name.
VANITY_URL=http://192.168.1.10:8090
# Directory the headless CLI is allowed to read files from (mounted to /import in compose).
IMPORT_DIR_ALLOWLIST=/import
# Nothing sits in front of the importer, so there is no proxy to trust.
TRUSTED_PROXIES=
#
# Personal Access Token. Required in practice: the importer's web UI only offers a "Client ID" field, and
# the OAuth client flow fails on Firefly 6.7.9 with SQLSTATE[22P02] (a JWT client id cast to uuid).
# Setting the token here makes the importer skip that flow entirely.
# Create it in Firefly: profile icon -> "Remote access and tokens" -> Personal Access Tokens ->
# "Create new token". It is shown once. Keep this file at mode 600; it is git-ignored.
# FIREFLY_III_ACCESS_TOKEN=