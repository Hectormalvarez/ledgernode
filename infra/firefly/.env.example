# Copy to .env, fill the secrets, never commit it (.env is git-ignored).
#
# APP_KEY and STATIC_CRON_TOKEN must each be exactly 32 alphanumeric characters, no symbols:
#   head -c 512 /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32
APP_KEY=CHANGEME32ALNUMCHARACTERSVALUE000
APP_ENV=local
APP_DEBUG=false
APP_URL=http://192.168.1.10:8090
SITE_OWNER=you@example.com
TZ=America/Chicago
DEFAULT_LANGUAGE=en_US
# No proxy or tunnel sits in front of this instance (US-001 limitation 5), so there is nothing to
# trust. Set to ** only if a reverse proxy is ever put in front of it.
TRUSTED_PROXIES=

# Database — must match .db.env. PostgreSQL, not the vendor's default MariaDB (ADR-0001).
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=CHANGEME

# Token the cron sidecar calls to trigger Firefly III's scheduled jobs.
STATIC_CRON_TOKEN=CHANGEME32ALNUMCHARACTERSVALUE111

# Published address. LAN address only — never 0.0.0.0 (ADR-0001).
BIND_ADDRESS=192.168.1.10
HOST_PORT=8090
IMPORTER_PORT=8091
