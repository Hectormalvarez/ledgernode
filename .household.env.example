# Household values — copy to .household.env (git-ignored) and fill in the real figures.
#
# Everything in this file is optional. It exists so that tracked files can refer to a stable
# name instead of embedding personal detail, and so the one place personal detail lives is
# obvious and easy to keep out of version control.
#
# Rule: if a value would identify the household, it belongs here and nowhere else.

# --- Institutions -------------------------------------------------------------------------
BANK_A=Bank A
BANK_A_LAST4=0000
BANK_B=Bank B
BANK_B_LAST4=0000
PREPAID_APP=Prepaid app

# --- People -------------------------------------------------------------------------------
# Tracked files use roles only. Map them here if you want the real names locally.
PARTNER=Partner
HOUSEHOLD_MEMBER_1=Relative
HOUSEHOLD_MEMBER_2=Relative

# --- Income -------------------------------------------------------------------------------
# Net take-home per check, and how often each arrives.
CHECK_A=0.00
CHECK_A_CADENCE=bi-weekly
CHECK_B=0.00
CHECK_B_CADENCE=bi-weekly

# --- Committed outflows (monthly) ---------------------------------------------------------
RENT=0.00
RENT_LATE_FEE=0.00
UTILITIES=0.00
PHONE=0.00
INTERNET=0.00
ORTHODONTICS=0.00
GROCERIES=0.00
FUEL=0.00

# --- Balances -----------------------------------------------------------------------------
NET_WORTH=0.00
TOTAL_DEBT=0.00
EMERGENCY_BUFFER_TARGET=0.00

# --- Host ---------------------------------------------------------------------------------
# Only used when you copy infra/firefly/.env.example. The example ships with 192.168.1.10.
LAN_BIND_ADDRESS=192.168.1.10
HOST_ALIAS=host-a
SSH_USER=admin
FIREFLY_III_URL=http://192.168.1.10:8090
